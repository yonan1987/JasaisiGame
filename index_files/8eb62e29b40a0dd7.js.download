<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Katalog Game - MIKAYLA GAMES | Jasa Isi Game PlayStation Premium Bandung</title>
  <meta name="description" content="Katalog game PlayStation lengkap dari MIKAYLA GAMES - Jasa isi game PS3 HEN, PS4 HEN, PS5 Jailbreak di Bandung.">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --gold: #D4AF37; --gold-light: #F0D060; --gold-dark: #B8960C;
      --bg-dark: #0a0a0a; --bg-card: #111111; --bg-card-hover: #1a1a1a;
      --text-primary: #f0f0f0; --text-secondary: #a0a0a0; --text-muted: #666;
    }
    body { font-family: 'Poppins', sans-serif; background: var(--bg-dark); color: var(--text-primary); line-height: 1.6; }
    .header { background: linear-gradient(135deg, #0f0f0f 0%, #1a1a0a 50%, #0f0f0f 100%); border-bottom: 2px solid var(--gold); padding: 40px 20px; text-align: center; position: relative; overflow: hidden; }
    .header::before { content: ''; position: absolute; top: 0; left: -50%; width: 200%; height: 100%; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.05), transparent); animation: shimmer 4s linear infinite; }
    @keyframes shimmer { 0% { transform: translateX(-50%); } 100% { transform: translateX(50%); } }
    .header h1 { font-family: 'Montserrat', sans-serif; font-size: 2.5rem; font-weight: 800; background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold), var(--gold-dark), var(--gold)); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: goldShimmer 3s linear infinite; margin-bottom: 8px; }
    @keyframes goldShimmer { 0% { background-position: -200% center; } 100% { background-position: 200% center; } }
    .header .subtitle { color: var(--text-secondary); font-size: 1rem; margin-bottom: 20px; }
    .header .badge-row { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
    .header .badge-item { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(212,175,55,0.3); background: rgba(212,175,55,0.08); color: var(--gold); font-size: 0.8rem; font-weight: 500; }
    .contact-bar { background: var(--bg-card); border: 1px solid rgba(212,175,55,0.15); border-radius: 16px; margin: 24px auto; max-width: 900px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
    .contact-item { display: flex; align-items: center; gap: 12px; }
    .contact-icon { width: 40px; height: 40px; border-radius: 10px; background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
    .contact-text { font-size: 0.85rem; }
    .contact-text .label { color: var(--gold); font-weight: 600; display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .contact-text .value { color: var(--text-primary); }
    .contact-text .value a { color: var(--gold); text-decoration: none; }
    .pricing { margin: 24px auto; max-width: 900px; }
    .pricing h2 { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; color: var(--gold); margin-bottom: 16px; text-align: center; }
    .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
    .price-card { background: var(--bg-card); border: 1px solid rgba(212,175,55,0.15); border-radius: 12px; padding: 20px; text-align: center; transition: all 0.3s; }
    .price-card:hover { border-color: var(--gold); box-shadow: 0 0 20px rgba(212,175,55,0.15); }
    .price-card .service-name { font-weight: 700; font-size: 0.9rem; margin-bottom: 8px; }
    .price-card .price { font-family: 'Montserrat', sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--gold); }
    .price-card .price-note { font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; }
    .table-section { margin: 32px auto; max-width: 1200px; padding: 0 20px; }
    .table-section h2 { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; color: var(--gold); margin-bottom: 8px; text-align: center; }
    .table-section .section-sub { text-align: center; color: var(--text-muted); font-size: 0.85rem; margin-bottom: 24px; }
    .platform-section { margin-bottom: 32px; }
    .platform-title { font-family: 'Montserrat', sans-serif; font-size: 1.2rem; font-weight: 700; padding: 10px 20px; border-radius: 10px; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
    .platform-title.ps5 { background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(100,100,100,0.08)); border: 1px solid rgba(255,255,255,0.15); color: #e0e0e0; }
    .platform-title.ps4 { background: linear-gradient(135deg, rgba(0,50,167,0.15), rgba(0,30,100,0.08)); border: 1px solid rgba(0,70,180,0.3); color: #6090ff; }
    .platform-title.ps3 { background: linear-gradient(135deg, rgba(0,30,120,0.15), rgba(0,15,80,0.08)); border: 1px solid rgba(0,50,150,0.3); color: #4080ff; }
    .platform-count { font-size: 0.75rem; font-weight: 400; opacity: 0.7; }
    .table-wrapper { overflow-x: auto; border-radius: 12px; border: 1px solid rgba(212,175,55,0.1); }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    thead th { background: rgba(212,175,55,0.08); color: var(--gold); padding: 12px 16px; text-align: left; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(212,175,55,0.2); white-space: nowrap; }
    .game-row { transition: background 0.2s; }
    .game-row:hover { background: var(--bg-card-hover); }
    .game-row td { padding: 10px 16px; border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; }
    .num { color: var(--text-muted); font-size: 0.8rem; width: 40px; }
    .game-name { font-weight: 600; min-width: 200px; }
    .genre { color: var(--text-secondary); }
    .size { color: var(--text-secondary); white-space: nowrap; }
    .status { white-space: nowrap; }
    .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,0.5); vertical-align: middle; }
    .badge { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .badge-ps5 { background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(200,200,200,0.08)); color: #e0e0e0; border: 1px solid rgba(255,255,255,0.2); }
    .badge-ps4 { background: linear-gradient(135deg, rgba(0,50,167,0.2), rgba(0,30,100,0.1)); color: #6090ff; border: 1px solid rgba(0,70,180,0.3); }
    .badge-ps3 { background: linear-gradient(135deg, rgba(0,30,120,0.2), rgba(0,15,80,0.1)); color: #4080ff; border: 1px solid rgba(0,50,150,0.3); }
    .order-btn { display: inline-block; padding: 5px 14px; border-radius: 6px; background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-light)); color: #000; font-size: 0.75rem; font-weight: 700; text-decoration: none; transition: all 0.3s; white-space: nowrap; }
    .order-btn:hover { box-shadow: 0 0 15px rgba(212,175,55,0.4); transform: translateY(-1px); }
    .cta-section { margin: 40px auto; max-width: 900px; padding: 0 20px; }
    .cta-box { background: linear-gradient(135deg, rgba(212,175,55,0.08), rgba(212,175,55,0.02)); border: 2px solid rgba(212,175,55,0.3); border-radius: 20px; padding: 40px; text-align: center; }
    .cta-box h3 { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; color: var(--gold); margin-bottom: 12px; }
    .cta-box p { color: var(--text-secondary); margin-bottom: 24px; font-size: 0.95rem; }
    .wa-cta { display: inline-flex; align-items: center; gap: 10px; padding: 14px 32px; border-radius: 12px; background: linear-gradient(135deg, #25D366, #128C7E); color: #fff; font-size: 1rem; font-weight: 700; text-decoration: none; transition: all 0.3s; }
    .wa-cta:hover { box-shadow: 0 0 25px rgba(37,211,102,0.4); transform: translateY(-2px); }
    .footer { text-align: center; padding: 32px 20px; border-top: 1px solid rgba(212,175,55,0.15); margin-top: 40px; }
    .footer .brand { font-family: 'Montserrat', sans-serif; font-weight: 800; color: var(--gold); font-size: 1.1rem; margin-bottom: 6px; }
    .footer .tagline { color: var(--text-muted); font-size: 0.8rem; margin-bottom: 12px; }
    .footer .note { color: var(--text-muted); font-size: 0.7rem; }
    @media print { .order-btn, .wa-cta { display: none; } .game-row:hover { background: transparent; } }
    @media (max-width: 768px) { .header h1 { font-size: 1.8rem; } .contact-bar { grid-template-columns: 1fr; padding: 16px; } .pricing-grid { grid-template-columns: repeat(2, 1fr); } table { font-size: 0.75rem; } thead th, .game-row td { padding: 8px 10px; } .game-name { min-width: 140px; } }
  </style>
</head>
<body>
  <div class="header">
    <h1>MIKAYLA GAMES</h1>
    <p class="subtitle">Katalog Game & Layanan PlayStation Premium | Bandung</p>
    <div class="badge-row">
      <span class="badge-item">🎮 ${d6.length}+ Game Tersedia</span>
      <span class="badge-item">⭐ 4.9/5.0 Rating</span>
      <span class="badge-item">📍 Bandung</span>
      <span class="badge-item">🔒 Aman & Bergaransi</span>
    </div>
  </div>
  <div class="contact-bar">
    <div class="contact-item">
      <div class="contact-icon">📱</div>
      <div class="contact-text">
        <span class="label">WhatsApp</span>
        <span class="value"><a href="https://wa.me/6285163061987">+62 851-6306-1987</a></span>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-icon">📍</div>
      <div class="contact-text">
        <span class="label">Alamat</span>
        <span class="value">Jatimulya V, Gumuruh, Batununggal, Bandung 40275</span>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-icon">🕐</div>
      <div class="contact-text">
        <span class="label">Jam Operasional</span>
        <span class="value">Senin - Minggu, 09:00 - 21:00</span>
      </div>
    </div>
  </div>
  <div class="pricing">
    <h2>💰 Harga Layanan</h2>
    <div class="pricing-grid">
      <div class="price-card"><div class="service-name">PS3 HEN</div><div class="price">Rp100K</div><div class="price-note">Mulai dari</div></div>
      <div class="price-card"><div class="service-name">PS4 HEN</div><div class="price">Rp150K</div><div class="price-note">Mulai dari</div></div>
      <div class="price-card"><div class="service-name">PS5 Jailbreak</div><div class="price">Rp250K</div><div class="price-note">Mulai dari</div></div>
      <div class="price-card"><div class="service-name">Update & Maintenance</div><div class="price">Rp50K</div><div class="price-note">Mulai dari</div></div>
    </div>
  </div>
  <div class="table-section">
    <h2>🎮 Katalog Game</h2>
    <p class="section-sub">Daftar game PlayStation yang tersedia untuk instalasi</p>
    <div class="platform-section">
      <div class="platform-title ps5">🎮 PlayStation 5 <span class="platform-count">(${e.length} game)</span></div>
      <div class="table-wrapper"><table><thead><tr><th>No</th><th>Nama Game</th><th>Platform</th><th>Genre</th><th>Ukuran</th><th>Status</th><th>Pesan</th></tr></thead><tbody>${n(e)}</tbody></table></div>
    </div>
    <div class="platform-section">
      <div class="platform-title ps4">🎮 PlayStation 4 <span class="platform-count">(${t.length} game)</span></div>
      <div class="table-wrapper"><table><thead><tr><th>No</th><th>Nama Game</th><th>Platform</th><th>Genre</th><th>Ukuran</th><th>Status</th><th>Pesan</th></tr></thead><tbody>${n(t)}</tbody></table></div>
    </div>
    <div class="platform-section">
      <div class="platform-title ps3">🎮 PlayStation 3 <span class="platform-count">(${a.length} game)</span></div>
      <div class="table-wrapper"><table><thead><tr><th>No</th><th>Nama Game</th><th>Platform</th><th>Genre</th><th>Ukuran</th><th>Status</th><th>Pesan</th></tr></thead><tbody>${n(a)}</tbody></table></div>
    </div>
  </div>
  <div class="cta-section">
    <div class="cta-box">
      <h3>🎮 Siap Isi Game?</h3>
      <p>Hubungi kami sekarang via WhatsApp untuk konsultasi gratis dan pemesanan!</p>
      <a href="https://wa.me/6285163061987?text=${encodeURIComponent("Halo Mikayla Games, saya tertarik dengan layanan isi game PlayStation.")}" class="wa-cta" target="_blank" rel="noopener noreferrer">💬 Chat WhatsApp Sekarang</a>
    </div>
  </div>
  <div class="footer">
    <div class="brand">MIKAYLA GAMES</div>
    <div class="tagline">Jasa Isi Game PlayStation Premium di Bandung</div>
    <div class="note">WhatsApp: +62 851-6306-1987 | wa.me/6285163061987<br>Jatimulya V, Kel. Gumuruh, Kec. Batununggal, Kota Bandung 40275<br>\xa9 ${new Date().getFullYear()} MIKAYLA GAMES. All rights reserved.</div>
  </div>
</body>
