          }
        }
      });
    });
    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        const href = this.getAttribute('href');
        if (href) {
          const target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
    // Nav active link highlight on scroll
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('nav a[href^="#"]');
    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = (section as HTMLElement).offsetTop - 100;
        if (window.scrollY >= sectionTop) current = section.getAttribute('id') || '';
      });
      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + current) link.classList.add('active');
      });
    });
    // Mobile nav toggle
    const mobileMenuBtn = document.querySelector('[aria-label="Toggle menu"]');
    const mobileMenu = document.querySelector('.mobile-menu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
    // Platform filter for game catalog
    document.querySelectorAll('[data-platform-filter]').forEach(btn => {
      btn.addEventListener('click', function() {
        const filter = this.dataset.platformFilter;
        document.querySelectorAll('[data-game-platform]').forEach(card => {
          (card as HTMLElement).style.display = (filter === 'all' || card.dataset.gamePlatform === filter) ? '' : 'none';
        });
      });
    });
    // Load more games button
    const loadMoreBtn = document.querySelector('button[class*="Lihat Lebih Banyak"]');
    if (loadMoreBtn) {
      let visibleCount = 12;
      loadMoreBtn.addEventListener('click', () => {
        visibleCount += 12;
        document.querySelectorAll('[data-game-platform]').forEach((card, i) => {
          (card as HTMLElement).style.display = i < visibleCount ? '' : 'none';
        });
      });
    }
    // Back to top
    const backToTop = document.querySelector('a[aria-label="Back to top"], a:has(svg)');
    if (backToTop) {
      backToTop.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
    // Scroll progress indicator
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      const bar = document.querySelector('.scroll-progress-bar');
      if (bar) (bar as HTMLElement).style.width = progress + '%';
    });
    console.log('🎮 MIKAYLA GAMES - Website exported successfully!');
  </script>
</body>
</html>`;
