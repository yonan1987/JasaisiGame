// ==================== HELPERS ====================
function calculateCallFee(km) {
    if (km <= 5) return 50000;
    if (km <= 10) return 75000;
    if (km <= 15) return 100000;
    if (km <= 20) return 125000;
    return 125000 + (km - 20) * 5000;
}
function getGenreGradient(genre) {
    const g = genre.toLowerCase();
    if (g.includes("action")) return "from-red-900 via-red-800 to-orange-900";
    if (g.includes("rpg") || g.includes("jrpg")) return "from-purple-900 via-indigo-900 to-violet-900";
    if (g.includes("fps") || g.includes("shooter")) return "from-gray-900 via-slate-800 to-zinc-900";
    if (g.includes("racing")) return "from-emerald-900 via-green-900 to-teal-900";
    if (g.includes("horror") || g.includes("survival")) return "from-stone-950 via-neutral-900 to-zinc-950";
    if (g.includes("fighting")) return "from-rose-950 via-red-950 to-pink-950";
    if (g.includes("sport")) return "from-sky-950 via-cyan-900 to-blue-950";
    if (g.includes("platform")) return "from-amber-950 via-yellow-900 to-orange-950";
    if (g.includes("puzzle") || g.includes("strategy")) return "from-fuchsia-950 via-purple-950 to-violet-950";
    if (g.includes("stealth")) return "from-slate-950 via-gray-950 to-neutral-950";
    return "from-blue-950 via-indigo-950 to-slate-950";
}
function getGenreIcon(genre) {
    const g = genre.toLowerCase();
    if (g.includes("action")) return "⚔️";
    if (g.includes("rpg") || g.includes("jrpg")) return "🔮";
    if (g.includes("fps") || g.includes("shooter")) return "🎯";
    if (g.includes("racing")) return "🏎️";
    if (g.includes("horror") || g.includes("survival")) return "👻";
    if (g.includes("fighting")) return "🥊";
    if (g.includes("sport")) return "⚽";
    if (g.includes("platform")) return "🍄";
    if (g.includes("puzzle") || g.includes("strategy")) return "🧩";
    if (g.includes("stealth")) return "🥷";
    if (g.includes("drama")) return "🎬";
    return "🎮";
}
